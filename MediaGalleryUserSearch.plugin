__id__ = "media_user_searchbar"
__name__ = "Media User Searchbar"
__author__ = "@cursor_agent"
__version__ = "1.2.0"
__description__ = "Uses native SharedMedia search UI and enforces strict sender filtering."
__min_version__ = "11.12.0"
__icon__ = "msg_search"

import time
import weakref

from java import dynamic_proxy, jint

from base_plugin import BasePlugin, MenuItemData, MenuItemType, MethodHook
from hook_utils import find_class, get_private_field
from android_utils import run_on_ui_thread, OnClickListener, log
from client_utils import get_last_fragment, get_messages_controller
from ui.bulletin import BulletinHelper
from ui.settings import Header, Input, Switch, Text

from android.content import Context, ClipData
from android.text import TextWatcher
from org.telegram.messenger import ApplicationLoader, NotificationCenter, MediaDataController


TAG = "[MediaUserSearch]"
MENU_FILTER_ID = 917431


def _safe_call(fn, default=None):
    try:
        return fn()
    except Exception:
        return default


class _ProfileHook(MethodHook):
    def __init__(self, plugin, method_name):
        self.plugin = plugin
        self.method_name = method_name

    def before_hooked_method(self, param):
        self.plugin._on_profile_event(self.method_name, param, before=True)

    def after_hooked_method(self, param):
        self.plugin._on_profile_event(self.method_name, param, before=False)


class _LaunchHook(MethodHook):
    def __init__(self, plugin, method_name):
        self.plugin = plugin
        self.method_name = method_name

    def before_hooked_method(self, param):
        self.plugin._on_launch_event(self.method_name, param, before=True)

    def after_hooked_method(self, param):
        self.plugin._on_launch_event(self.method_name, param, before=False)


class _SharedMediaCtorHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        self.plugin._attach_shared_media_layout(param.thisObject)


class _SharedMediaHook(MethodHook):
    def __init__(self, plugin, method_name):
        self.plugin = plugin
        self.method_name = method_name

    def after_hooked_method(self, param):
        self.plugin._on_shared_media_event(self.method_name, param)


class MediaUserSearchbarPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._hook_refs = []
        self._profile_ref = None
        self._layout_refs = {}          # layout_id -> weakref(layout)
        self._watchers = {}             # layout_id -> {"edit": edit, "watcher": watcher}
        self._last_applied_query = {}   # layout_id -> native query (from:...)
        self._original_media = {}       # layout_id -> tab_index -> [MessageObject]
        self._snapshot_query = {}       # layout_id -> native query captured in _original_media
        self._prefetch_state = {}       # layout_id -> {"active": bool}
        self._log_buffer = []
        self._query = ""
        self._debug = False
        self._suppress_text_events = False

    def on_plugin_load(self):
        self._query = str(self.get_setting("media_user_query", "") or "").strip()
        self._debug = bool(self.get_setting("debug_logs", False))
        self._install_hooks()
        self._register_profile_menu_item()
        self._dlog("loaded")

    def on_plugin_unload(self):
        for ref in list(self._hook_refs):
            _safe_call(lambda ref=ref: self.unhook_method(ref))
        self._hook_refs = []
        self._layout_refs.clear()
        self._watchers.clear()
        self._last_applied_query.clear()
        self._original_media.clear()
        self._snapshot_query.clear()
        self._prefetch_state.clear()
        self._profile_ref = None
        self._dlog("unloaded")

    def create_settings(self):
        return [
            Header(text="Media User Searchbar"),
            Input(
                key="media_user_query",
                text="Default query",
                subtext="Supports @username, numeric id, or plain text.",
                default=str(self.get_setting("media_user_query", "")),
                on_change=lambda v: self._set_query(str(v or "")),
            ),
            Input(
                key="search_hint",
                text="Search hint",
                subtext="Hint for native SharedMedia search field.",
                default=str(self.get_setting("search_hint", "Filter media by @username / user id")),
            ),
            Switch(
                key="keep_after_resume",
                text="Keep filter on resume",
                subtext="Re-apply current query after app resume/account switch.",
                default=True,
            ),
            Switch(
                key="debug_logs",
                text="Debug logs",
                subtext="Print extra plugin logs.",
                default=False,
                on_change=lambda v: setattr(self, "_debug", bool(v)),
            ),
            Text(
                text="Copy plugin logs",
                subtext="Copies recent plugin logs to clipboard.",
                on_click=lambda v: self._copy_logs_to_clipboard(),
            ),
            Text(
                text="Native UI mode: uses SharedMedia built-in search field",
                subtext="The plugin enforces strict sender filtering after native search.",
            ),
        ]

    def _install_hooks(self):
        self._hook_profile_activity()
        self._hook_launch_activity()
        self._hook_shared_media_layout()

    def _register_profile_menu_item(self):
        try:
            self.add_menu_item(
                MenuItemData(
                    menu_type=MenuItemType.PROFILE_ACTION_MENU,
                    text="Media filter",
                    icon="msg_search",
                    on_click=lambda ctx: run_on_ui_thread(self._open_native_search_from_menu),
                    priority=980,
                )
            )
        except Exception as e:
            self._dlog("profile menu registration failed: %s" % e)

    def _hook_profile_activity(self):
        cls = find_class("org.telegram.ui.ProfileActivity")
        if not cls:
            return
        for name in (
            "onFragmentCreate",
            "createMenu",
            "createActionBarMenu",
            "setUserInfo",
            "updateOnlineStatus",
            "onAvatarClick",
            "expandHeader",
        ):
            self._hook_all_methods(cls, name, _ProfileHook(self, name))

    def _hook_launch_activity(self):
        cls = find_class("org.telegram.ui.LaunchActivity")
        if not cls:
            return
        for name in ("handleIntent", "onResume", "switchToAccount", "showPasscode"):
            self._hook_all_methods(cls, name, _LaunchHook(self, name))

    def _hook_shared_media_layout(self):
        cls = find_class("org.telegram.ui.Components.SharedMediaLayout")
        if not cls:
            return
        try:
            refs = self.hook_all_constructors(cls, _SharedMediaCtorHook(self))
            if refs:
                if isinstance(refs, list):
                    self._hook_refs.extend(refs)
                else:
                    self._hook_refs.append(refs)
        except Exception:
            pass
        for name in ("setUserInfo", "setChatInfo", "updateTabs", "scrollToPage", "didReceivedNotification"):
            self._hook_all_methods(cls, name, _SharedMediaHook(self, name))

    def _hook_all_methods(self, cls, method_name, hook):
        try:
            refs = self.hook_all_methods(cls, method_name, hook)
            if not refs:
                return
            if isinstance(refs, list):
                self._hook_refs.extend(refs)
            else:
                self._hook_refs.append(refs)
        except Exception:
            pass

    def _on_profile_event(self, method_name, param, before):
        if before:
            return
        profile = param.thisObject
        if profile is not None:
            self._profile_ref = weakref.ref(profile)
            if method_name in ("createMenu", "createActionBarMenu"):
                action_bar = _safe_call(profile.getActionBar)
                run_on_ui_thread(lambda: self._ensure_actionbar_filter_item(action_bar))
        if method_name in ("onFragmentCreate", "setUserInfo", "createMenu", "createActionBarMenu"):
            run_on_ui_thread(self._sync_all_layouts, 80)
        elif method_name in ("updateOnlineStatus", "expandHeader"):
            run_on_ui_thread(self._refresh_native_hints, 60)
        elif method_name == "onAvatarClick":
            run_on_ui_thread(self._focus_current_search)

    def _on_launch_event(self, method_name, param, before):
        if method_name in ("handleIntent", "switchToAccount", "showPasscode") and before:
            return
        if method_name == "onResume" and not before and bool(self.get_setting("keep_after_resume", True)):
            run_on_ui_thread(self._sync_all_layouts, 140)

    def _on_shared_media_event(self, method_name, param):
        layout = param.thisObject
        self._attach_shared_media_layout(layout)
        if method_name == "didReceivedNotification":
            try:
                if param.args and int(param.args[0]) == int(NotificationCenter.mediaDidLoad):
                    run_on_ui_thread(lambda: self._on_media_loaded(layout), 30)
            except Exception:
                pass
            return
        if method_name in ("setUserInfo", "setChatInfo", "updateTabs", "scrollToPage"):
            run_on_ui_thread(lambda: self._apply_query_to_layout(layout), 40)

    def _attach_shared_media_layout(self, layout):
        if layout is None:
            return
        lid = id(layout)
        if lid not in self._layout_refs:
            self._layout_refs[lid] = weakref.ref(layout)
        run_on_ui_thread(lambda: self._bind_native_search_field(layout), 60)
        run_on_ui_thread(lambda: self._apply_query_to_layout(layout), 120)

    def _sync_all_layouts(self):
        dead = []
        for lid, ref in list(self._layout_refs.items()):
            layout = _safe_call(ref)
            if layout is None:
                dead.append(lid)
                continue
            self._bind_native_search_field(layout)
            self._apply_query_to_layout(layout)
        for lid in dead:
            self._layout_refs.pop(lid, None)
            self._watchers.pop(lid, None)
            self._last_applied_query.pop(lid, None)
            self._original_media.pop(lid, None)
            self._snapshot_query.pop(lid, None)

    def _bind_native_search_field(self, layout):
        if layout is None:
            return
        item = self._get_layout_search_item(layout)
        if item is None:
            return
        _safe_call(lambda: item.setSearchFieldHint(self._hint_text()))
        edit = _safe_call(item.getSearchField)
        if edit is None:
            return

        lid = id(layout)
        existing = self._watchers.get(lid)
        if existing and existing.get("edit") is edit:
            return

        plugin = self

        class _Watcher(dynamic_proxy(TextWatcher)):
            def beforeTextChanged(self, s, st, c, a):
                pass

            def onTextChanged(self, s, st, b, c):
                pass

            def afterTextChanged(self, s):
                if plugin._suppress_text_events:
                    return
                raw = str(s.toString() if s is not None else "").strip()
                plugin._set_query_from_native(raw)
                plugin._apply_local_sender_filter(layout)
                if plugin._debug:
                    run_on_ui_thread(lambda: plugin._log_filtered_media_snapshot(layout, plugin._native_query(plugin._query), "native-edit"), 150)

        watcher = _Watcher()
        _safe_call(lambda: edit.addTextChangedListener(watcher))
        self._watchers[lid] = {"edit": edit, "watcher": watcher}

    def _set_query(self, value):
        normalized = str(value or "").strip()
        if normalized == self._query:
            return
        self._query = normalized
        _safe_call(lambda: self.set_setting("media_user_query", normalized))
        run_on_ui_thread(self._sync_all_layouts)

    def _set_query_from_native(self, text):
        raw = str(text or "").strip()
        if raw.lower().startswith("from:"):
            raw = raw[5:].strip()
        if raw == self._query:
            return
        self._query = raw
        _safe_call(lambda: self.set_setting("media_user_query", raw))

    def _apply_query_to_layout(self, layout):
        lid = id(layout)
        item = self._get_layout_search_item(layout)
        if item is None:
            self._last_applied_query.pop(lid, None)
            return

        _safe_call(lambda: item.setSearchFieldHint(self._hint_text()))
        self._bind_native_search_field(layout)

        # In ProfileActivity, SharedMedia search button becomes truly usable only
        # after user scrolls to media header area. Until then, defer applying to
        # avoid forcing search mode immediately after opening profile.
        if not self._is_media_search_ready(layout, item):
            if self._debug:
                self._dlog("deferred apply: media section is not visible yet")
            return

        native_query = self._native_query(self._query)
        previous = self._last_applied_query.get(lid)
        if previous == native_query:
            self._apply_local_sender_filter(layout)
            self._schedule_history_prefetch(layout, "same-query")
            if self._debug:
                run_on_ui_thread(lambda: self._log_filtered_media_snapshot(layout, native_query, "apply-same"), 240)
            return

        # Query changed -> new native result set expected, reset snapshots.
        self._original_media.pop(lid, None)
        self._snapshot_query.pop(lid, None)
        self._last_applied_query[lid] = native_query

        self._suppress_text_events = True
        try:
            if native_query:
                _safe_call(lambda: item.openSearch(False))
                _safe_call(lambda: item.setSearchFieldText(native_query, False))
            else:
                _safe_call(lambda: item.setSearchFieldText("", False))
        finally:
            self._suppress_text_events = False

        run_on_ui_thread(lambda: self._apply_local_sender_filter(layout), 160)
        run_on_ui_thread(lambda: self._apply_local_sender_filter(layout), 420)
        self._schedule_history_prefetch(layout, "new-query")
        if self._debug:
            run_on_ui_thread(lambda: self._log_filtered_media_snapshot(layout, native_query, "apply-new"), 500)

    def _apply_local_sender_filter(self, layout):
        data_array = _safe_call(lambda: get_private_field(layout, "sharedMediaData"))
        if data_array is None:
            return

        lid = id(layout)
        native_query = self._last_applied_query.get(lid, self._native_query(self._query))
        target_id, target_text = self._parse_sender_filter(self._query)

        if target_id is None and not target_text:
            self._restore_original_media(layout, data_array)
            return

        snapshots = self._ensure_original_media_snapshot(layout, data_array, native_query)
        for tab_index, source in list(snapshots.items()):
            data = self._array_get(data_array, tab_index)
            if data is None:
                continue
            messages = _safe_call(lambda: get_private_field(data, "messages"))
            if messages is None:
                continue
            filtered = []
            for msg in source:
                if self._message_matches_sender_filter(msg, target_id, target_text):
                    filtered.append(msg)
            self._replace_java_list(messages, filtered)
            self._sync_total_count_field(data, len(filtered))
        self._notify_media_pages_changed(layout)

    def _ensure_original_media_snapshot(self, layout, data_array, query_key):
        lid = id(layout)
        if self._snapshot_query.get(lid) != query_key:
            self._original_media[lid] = {}
            self._snapshot_query[lid] = query_key
        tab_map = self._original_media.setdefault(lid, {})

        tabs_count = self._array_length(data_array)
        for tab_index in range(tabs_count):
            data = self._array_get(data_array, tab_index)
            if data is None:
                continue
            messages = _safe_call(lambda: get_private_field(data, "messages"))
            if messages is None:
                continue
            current_items = self._copy_java_list(messages)
            if tab_index not in tab_map:
                tab_map[tab_index] = current_items
            else:
                self._merge_snapshot_with_current(tab_map[tab_index], current_items)
        return tab_map

    def _merge_snapshot_with_current(self, snapshot, current_items):
        if snapshot is None or current_items is None:
            return
        known = {}
        for msg in snapshot:
            known[self._extract_message_id(msg)] = True
        for msg in current_items:
            mid = self._extract_message_id(msg)
            if mid not in known:
                snapshot.append(msg)
                known[mid] = True

    def _restore_original_media(self, layout, data_array):
        lid = id(layout)
        tab_map = self._original_media.get(lid)
        if not tab_map:
            return
        for tab_index, original in list(tab_map.items()):
            data = self._array_get(data_array, tab_index)
            if data is None:
                continue
            messages = _safe_call(lambda: get_private_field(data, "messages"))
            if messages is None:
                continue
            self._replace_java_list(messages, original)
            self._sync_total_count_field(data, len(original))
        self._notify_media_pages_changed(layout)
        self._original_media.pop(lid, None)
        self._snapshot_query.pop(lid, None)
        self._prefetch_state.pop(lid, None)

    def _on_media_loaded(self, layout):
        # New chunks arrived -> refresh strict sender filter and continue paging.
        self._apply_local_sender_filter(layout)
        self._schedule_history_prefetch(layout, "mediaDidLoad")
        if self._debug:
            run_on_ui_thread(lambda: self._log_filtered_media_snapshot(layout, self._native_query(self._query), "media-loaded"), 200)

    def _schedule_history_prefetch(self, layout, reason):
        target_id, target_text = self._parse_sender_filter(self._query)
        if target_id is None and not target_text:
            return
        lid = id(layout)
        state = self._prefetch_state.setdefault(lid, {"active": False})
        if state.get("active"):
            return
        state["active"] = True
        run_on_ui_thread(lambda: self._prefetch_step(layout, reason), 80)

    def _prefetch_step(self, layout, reason):
        lid = id(layout)
        state = self._prefetch_state.get(lid)
        if state is None:
            return
        try:
            target_id, target_text = self._parse_sender_filter(self._query)
            if target_id is None and not target_text:
                return
            if self._request_next_history_page(layout):
                if self._debug:
                    self._dlog("prefetch requested (%s)" % reason)
                return
            if self._is_selected_tab_loading(layout):
                run_on_ui_thread(lambda: self._schedule_history_prefetch(layout, "loading-wait"), 380)
        finally:
            state["active"] = False

    def _is_selected_tab_loading(self, layout):
        data_array = _safe_call(lambda: get_private_field(layout, "sharedMediaData"))
        if data_array is None:
            return False
        selected = self._get_selected_tab_type(layout)
        data = self._array_get(data_array, selected)
        if data is None:
            return False
        return bool(_safe_call(lambda: data.loading, False))

    def _request_next_history_page(self, layout):
        data_array = _safe_call(lambda: get_private_field(layout, "sharedMediaData"))
        if data_array is None:
            return False

        selected = self._get_selected_tab_type(layout)
        data = self._array_get(data_array, selected)
        if data is None:
            return False
        if bool(_safe_call(lambda: data.loading, False)):
            return False

        end0 = bool(_safe_call(lambda: data.endReached[0], True))
        end1 = bool(_safe_call(lambda: data.endReached[1], True))
        if end0 and end1:
            return False

        profile = _safe_call(lambda: get_private_field(layout, "profileActivity"))
        if profile is None:
            return False
        media = _safe_call(profile.getMediaDataController)
        if media is None:
            return False

        media_type = self._map_media_type_for_tab(selected, data_array)
        dialog_id = int(_safe_call(lambda: get_private_field(layout, "dialog_id"), 0) or 0)
        merge_dialog_id = int(_safe_call(lambda: get_private_field(layout, "mergeDialogId"), 0) or 0)
        topic_id = int(_safe_call(lambda: get_private_field(layout, "topicId"), 0) or 0)
        class_guid = int(_safe_call(profile.getClassGuid, 0) or 0)
        req_index = int(_safe_call(lambda: data.requestIndex, 0) or 0)
        max0 = int(_safe_call(lambda: data.max_id[0], 0) or 0)
        max1 = int(_safe_call(lambda: data.max_id[1], 0) or 0)

        if not end0 and dialog_id != 0:
            _safe_call(lambda: setattr(data, "loading", True))
            _safe_call(lambda: media.loadMedia(dialog_id, 50, max0, 0, media_type, topic_id, 1, class_guid, req_index))
            return True
        if merge_dialog_id != 0 and not end1:
            _safe_call(lambda: setattr(data, "loading", True))
            _safe_call(lambda: media.loadMedia(merge_dialog_id, 50, max1, 0, media_type, topic_id, 1, class_guid, req_index))
            return True
        return False

    def _get_selected_tab_type(self, layout):
        selected = int(_safe_call(layout.getSelectedTab, -1) or -1)
        if selected >= 0:
            return selected
        pages = _safe_call(lambda: get_private_field(layout, "mediaPages"))
        page0 = self._array_get(pages, 0) if pages is not None else None
        selected = int(_safe_call(lambda: get_private_field(page0, "selectedType"), 0) or 0)
        return max(0, selected)

    def _map_media_type_for_tab(self, selected, data_array):
        if selected == 0:
            data0 = self._array_get(data_array, 0)
            filter_type = int(_safe_call(lambda: data0.filterType, 0) or 0)
            if filter_type == 1:
                return int(MediaDataController.MEDIA_PHOTOS_ONLY)
            if filter_type == 2:
                return int(MediaDataController.MEDIA_VIDEOS_ONLY)
            return int(MediaDataController.MEDIA_PHOTOVIDEO)
        if selected == 1:
            return int(MediaDataController.MEDIA_FILE)
        if selected == 2:
            return int(MediaDataController.MEDIA_AUDIO)
        if selected == 4:
            return int(MediaDataController.MEDIA_MUSIC)
        if selected == 5:
            return int(MediaDataController.MEDIA_GIF)
        return int(MediaDataController.MEDIA_URL)

    def _message_matches_sender_filter(self, message_obj, target_id, target_text):
        sid = self._extract_sender_id(message_obj)
        if target_id is not None:
            return sid == target_id
        if not target_text:
            return True

        if sid != 0 and target_text in str(sid):
            return True

        user = self._resolve_user(sid)
        if user is not None:
            username = str(_safe_call(lambda: user.username, "") or "").lower()
            first_name = str(_safe_call(lambda: user.first_name, "") or "").lower()
            last_name = str(_safe_call(lambda: user.last_name, "") or "").lower()
            full_name = (first_name + " " + last_name).strip()
            if target_text in username or target_text in first_name or target_text in last_name or (full_name and target_text in full_name):
                return True

        post_author = str(_safe_call(lambda: message_obj.messageOwner.post_author, "") or "").lower()
        return bool(post_author and target_text in post_author)

    def _resolve_user(self, sender_id):
        if sender_id <= 0:
            return None
        controller = _safe_call(get_messages_controller)
        if controller is None:
            return None
        return _safe_call(lambda: controller.getUser(sender_id))

    def _parse_sender_filter(self, value):
        q = str(value or "").strip()
        if not q:
            return None, ""
        if q.lower().startswith("from:"):
            q = q[5:].strip()
        if q.startswith("@"):
            q = q[1:].strip()
        if not q:
            return None, ""
        try:
            if q.lstrip("-").isdigit():
                return int(q), ""
        except Exception:
            pass
        return None, q.lower()

    def _native_query(self, value):
        q = str(value or "").strip()
        if not q:
            return ""
        if q.lower().startswith("from:"):
            return q
        if q.startswith("@"):
            return "from:" + q[1:]
        return "from:" + q

    def _get_layout_search_item(self, layout):
        if layout is None:
            return None
        item = _safe_call(lambda: layout.getSearchItem())
        if item is not None:
            return item
        return _safe_call(lambda: get_private_field(layout, "searchItem"))

    def _ensure_actionbar_filter_item(self, action_bar):
        if action_bar is None:
            return
        menu = _safe_call(action_bar.createMenu)
        if menu is None:
            return
        item = _safe_call(lambda: menu.getItem(MENU_FILTER_ID))
        if item is None:
            icon = self._resolve_drawable_id(action_bar.getContext(), "msg_search", "menu_search", "ic_ab_search")
            item = _safe_call(lambda: menu.addItem(jint(MENU_FILTER_ID), jint(icon)))
        if item is None:
            return
        _safe_call(lambda: item.setOnClickListener(OnClickListener(lambda v: self._open_native_search_from_menu())))

    def _open_native_search_from_menu(self):
        layout = self._current_layout()
        if layout is None:
            self._show_bulletin("Open profile media first")
            return
        item = self._get_layout_search_item(layout)
        if item is None:
            self._show_bulletin("Native media search not available")
            return
        if not self._is_media_search_ready(layout, item):
            self._show_bulletin("Scroll down to the media section first")
            return
        native_query = self._native_query(self._query)
        self._suppress_text_events = True
        try:
            _safe_call(lambda: item.setSearchFieldHint(self._hint_text()))
            _safe_call(lambda: item.openSearch(True))
            _safe_call(lambda: item.setSearchFieldText(native_query, False))
            edit = _safe_call(item.getSearchField)
            if edit is not None:
                _safe_call(edit.requestFocus)
        finally:
            self._suppress_text_events = False
        run_on_ui_thread(lambda: self._apply_local_sender_filter(layout), 160)

    def _refresh_native_hints(self):
        for ref in list(self._layout_refs.values()):
            layout = _safe_call(ref)
            if layout is None:
                continue
            item = self._get_layout_search_item(layout)
            if item is not None:
                _safe_call(lambda item=item: item.setSearchFieldHint(self._hint_text()))

    def _focus_current_search(self):
        self._open_native_search_from_menu()

    def _is_media_search_ready(self, layout, item):
        if layout is None or item is None:
            return False
        # Search tab type support check.
        can_search_for_tab = bool(_safe_call(layout.isSearchItemVisible, True))
        if not can_search_for_tab:
            return False
        # Actual view visibility check (ProfileActivity toggles this when media
        # header appears/disappears while scrolling).
        visible = int(_safe_call(item.getVisibility, 8))
        if visible != 0:
            return False
        alpha = float(_safe_call(item.getAlpha, 1.0) or 0.0)
        return alpha > 0.0

    def _current_layout(self):
        for ref in list(self._layout_refs.values()):
            layout = _safe_call(ref)
            if layout is not None:
                return layout
        return None

    def _hint_text(self):
        return str(self.get_setting("search_hint", "Filter media by @username / user id"))

    def _copy_java_list(self, jlist):
        out = []
        if jlist is None:
            return out
        size = _safe_call(lambda: int(jlist.size()), 0)
        for i in range(size):
            item = _safe_call(lambda i=i: jlist.get(i))
            if item is not None:
                out.append(item)
        return out

    def _replace_java_list(self, jlist, items):
        if jlist is None:
            return
        _safe_call(jlist.clear)
        for item in items:
            _safe_call(lambda item=item: jlist.add(item))

    def _sync_total_count_field(self, data_obj, count):
        _safe_call(lambda: setattr(data_obj, "totalCount", jint(count)))
        _safe_call(lambda: setattr(data_obj, "count", jint(count)))

    def _notify_media_pages_changed(self, layout):
        pages = _safe_call(lambda: get_private_field(layout, "mediaPages"))
        if pages is None:
            return
        for i in range(self._array_length(pages)):
            page = self._array_get(pages, i)
            if page is None:
                continue
            list_view = _safe_call(lambda: get_private_field(page, "listView"))
            if list_view is None:
                continue
            adapter = _safe_call(list_view.getAdapter)
            if adapter is not None:
                _safe_call(adapter.notifyDataSetChanged)

    def _array_length(self, arr):
        if arr is None:
            return 0
        try:
            return int(arr.length)
        except Exception:
            pass
        try:
            return int(arr.size())
        except Exception:
            pass
        try:
            return int(len(arr))
        except Exception:
            return 0

    def _array_get(self, arr, idx):
        try:
            return arr[idx]
        except Exception:
            pass
        try:
            return arr.get(idx)
        except Exception:
            return None

    def _extract_message_id(self, message_obj):
        if message_obj is None:
            return 0
        for getter in ("getId", "getRealId"):
            try:
                if hasattr(message_obj, getter):
                    return int(getattr(message_obj, getter)())
            except Exception:
                pass
        owner = _safe_call(lambda: message_obj.messageOwner)
        if owner is not None:
            return int(_safe_call(lambda: owner.id, 0) or 0)
        return 0

    def _extract_sender_id(self, message_obj):
        if message_obj is None:
            return 0
        for getter in ("getFromChatId", "getFromId", "getSenderId"):
            try:
                if hasattr(message_obj, getter):
                    value = int(getattr(message_obj, getter)())
                    if value != 0:
                        return value
            except Exception:
                pass
        owner = _safe_call(lambda: message_obj.messageOwner)
        if owner is None:
            return 0
        from_id = _safe_call(lambda: owner.from_id)
        if from_id is not None:
            uid = int(_safe_call(lambda: from_id.user_id, 0) or 0)
            if uid:
                return uid
            cid = int(_safe_call(lambda: from_id.chat_id, 0) or 0)
            if cid:
                return -cid
            chid = int(_safe_call(lambda: from_id.channel_id, 0) or 0)
            if chid:
                return -chid
        return 0

    def _resolve_drawable_id(self, context, *names):
        try:
            res = context.getResources()
            pkg = context.getPackageName()
            for name in names:
                rid = int(res.getIdentifier(name, "drawable", pkg))
                if rid != 0:
                    return rid
        except Exception:
            pass
        return 0

    def _show_bulletin(self, text):
        _safe_call(lambda: BulletinHelper.show_info(str(text)))

    def _copy_logs_to_clipboard(self):
        try:
            text = "\n".join(self._log_buffer[-300:]) if self._log_buffer else "MediaUserSearch: logs are empty."
            context = _safe_call(lambda: ApplicationLoader.applicationContext)
            if context is None:
                self._show_bulletin("Clipboard unavailable: no app context")
                return
            clipboard = _safe_call(lambda: context.getSystemService(Context.CLIPBOARD_SERVICE))
            if clipboard is None:
                self._show_bulletin("Clipboard service not found")
                return
            clip = ClipData.newPlainText("MediaUserSearch logs", text)
            clipboard.setPrimaryClip(clip)
            self._show_bulletin("Plugin logs copied")
        except Exception as e:
            self._show_bulletin("Failed to copy plugin logs")
            self._dlog("copy logs error: %s" % e)

    def _log_filtered_media_snapshot(self, layout, query, stage):
        try:
            data_array = _safe_call(lambda: get_private_field(layout, "sharedMediaData"))
            if data_array is None:
                self._dlog("filtered list [%s] query='%s' -> sharedMediaData unavailable" % (stage, query))
                return
            parts = []
            total = 0
            tabs_count = self._array_length(data_array)
            for tab_index in range(tabs_count):
                data = self._array_get(data_array, tab_index)
                if data is None:
                    continue
                messages = _safe_call(lambda: get_private_field(data, "messages"))
                if messages is None:
                    continue
                count = _safe_call(lambda: int(messages.size()), 0)
                total += max(0, count)
                if count <= 0:
                    continue
                max_log_items = min(count, 15)
                items = []
                for i in range(max_log_items):
                    msg = _safe_call(lambda i=i: messages.get(i))
                    if msg is None:
                        continue
                    mid = self._extract_message_id(msg)
                    sid = self._extract_sender_id(msg)
                    items.append("%s:%s" % (mid, sid))
                suffix = "..." if count > max_log_items else ""
                parts.append("tab%d=%d[%s%s]" % (tab_index, count, ",".join(items), suffix))
            details = " | ".join(parts) if parts else "no-items"
            self._dlog("filtered list [%s] query='%s' tabs=%d total=%d %s" % (stage, query, tabs_count, total, details))
        except Exception as e:
            self._dlog("filtered list log error: %s" % e)

    def _dlog(self, message):
        line = "[%s] %s" % (time.strftime("%H:%M:%S"), str(message))
        self._log_buffer.append(line)
        if len(self._log_buffer) > 500:
            self._log_buffer = self._log_buffer[-350:]
        if self._debug:
            _safe_call(lambda: log("%s %s" % (TAG, line)))
