__id__ = "media_user_searchbar"
__name__ = "Media User Searchbar"
__author__ = "@cursor_agent"
__version__ = "1.1.0"
__description__ = "Adds a profile media searchbar to filter by sender via from:@username / id."
__min_version__ = "11.12.0"
__icon__ = "msg_search"

import weakref

from java import dynamic_proxy, jint

from base_plugin import BasePlugin, MenuItemData, MenuItemType, MethodHook
from hook_utils import find_class, get_private_field
from android_utils import run_on_ui_thread, OnClickListener, log
from client_utils import get_last_fragment
from ui.alert import AlertDialogBuilder
from ui.bulletin import BulletinHelper
from ui.settings import Header, Input, Switch, Text

from android.graphics.drawable import GradientDrawable
from android.text import InputType, TextWatcher
from android.view import Gravity, ViewGroup
from android.widget import EditText, ImageView, LinearLayout
from org.telegram.messenger import AndroidUtilities
from org.telegram.ui.ActionBar import Theme


TAG = "[MediaUserSearch]"
MENU_FILTER_ID = 917431
SEARCH_BAR_TAG = "media_user_searchbar_view"


def _safe_call(fn, default=None):
    try:
        return fn()
    except Exception:
        return default


class _ProfileHook(MethodHook):
    def __init__(self, plugin, method_name):
        self.plugin = plugin
        self.method_name = method_name

    def before_hooked_method(self, param):
        self.plugin._on_profile_event(self.method_name, param, before=True)

    def after_hooked_method(self, param):
        self.plugin._on_profile_event(self.method_name, param, before=False)


class _ActionBarHook(MethodHook):
    def __init__(self, plugin, method_name):
        self.plugin = plugin
        self.method_name = method_name

    def before_hooked_method(self, param):
        self.plugin._on_action_bar_event(self.method_name, param, before=True)

    def after_hooked_method(self, param):
        self.plugin._on_action_bar_event(self.method_name, param, before=False)


class _LaunchHook(MethodHook):
    def __init__(self, plugin, method_name):
        self.plugin = plugin
        self.method_name = method_name

    def before_hooked_method(self, param):
        self.plugin._on_launch_event(self.method_name, param, before=True)

    def after_hooked_method(self, param):
        self.plugin._on_launch_event(self.method_name, param, before=False)


class _SharedMediaCtorHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        self.plugin._attach_shared_media_layout(param.thisObject)


class _SharedMediaHook(MethodHook):
    def __init__(self, plugin, method_name):
        self.plugin = plugin
        self.method_name = method_name

    def after_hooked_method(self, param):
        self.plugin._on_shared_media_event(self.method_name, param)


class _ActionBarMenuClickHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        self.plugin._on_actionbar_menu_click(param)


class MediaUserSearchbarPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._hook_refs = []
        self._profile_ref = None
        self._action_bar_ref = None
        self._layout_refs = {}   # layout_id -> weakref(layout)
        self._bar_state = {}     # layout_id -> {bar, edit, watcher}
        self._query = ""
        self._debug = False
        self._suppress_text_events = False

    def on_plugin_load(self):
        self._query = str(self.get_setting("media_user_query", "") or "").strip()
        self._debug = bool(self.get_setting("debug_logs", False))
        self._install_hooks()
        self._register_profile_menu_item()
        self._dlog("loaded")

    def on_plugin_unload(self):
        for ref in list(self._hook_refs):
            try:
                self.unhook_method(ref)
            except Exception:
                pass
        self._hook_refs = []

        for state in list(self._bar_state.values()):
            bar = state.get("bar")
            if bar is not None:
                try:
                    parent = bar.getParent()
                    if parent is not None:
                        parent.removeView(bar)
                except Exception:
                    pass

        self._bar_state.clear()
        self._layout_refs.clear()
        self._profile_ref = None
        self._action_bar_ref = None
        self._dlog("unloaded")

    def create_settings(self):
        return [
            Header(text="Media User Searchbar"),
            Input(
                key="media_user_query",
                text="Default query",
                subtext="Supports @username, numeric id, or plain text.",
                default=str(self.get_setting("media_user_query", "")),
                on_change=lambda v: self._set_query(str(v or "")),
            ),
            Input(
                key="search_hint",
                text="Search hint",
                subtext="Hint for the inline media searchbar.",
                default=str(self.get_setting("search_hint", "Filter media by @username / user id")),
            ),
            Switch(
                key="keep_after_resume",
                text="Keep filter on resume",
                subtext="Re-apply current query after app resume/account switch.",
                default=True,
            ),
            Switch(
                key="debug_logs",
                text="Debug logs",
                subtext="Print extra plugin logs.",
                default=False,
                on_change=lambda v: setattr(self, "_debug", bool(v)),
            ),
            Text(
                text="Query is applied as native SharedMedia search: from:<query>",
                subtext="Uses built-in SharedMediaLayout search flow from AyuGram4A.",
            ),
        ]

    def _install_hooks(self):
        self._hook_profile_activity()
        self._hook_action_bar()
        self._hook_launch_activity()
        self._hook_actionbar_menu_click()
        self._hook_shared_media_layout()

    def _register_profile_menu_item(self):
        try:
            self.add_menu_item(
                MenuItemData(
                    menu_type=MenuItemType.PROFILE_ACTION_MENU,
                    text="Media filter",
                    icon="msg_search",
                    on_click=lambda ctx: run_on_ui_thread(self._show_filter_dialog),
                    priority=980,
                )
            )
        except Exception as e:
            self._dlog("profile menu registration failed: %s" % e)

    def _hook_profile_activity(self):
        cls = find_class("org.telegram.ui.ProfileActivity")
        if not cls:
            return
        # User requested hook list
        for name in (
            "onFragmentCreate",
            "createMenu",
            "setUserInfo",
            "updateOnlineStatus",
            "onAvatarClick",
            "expandHeader",
        ):
            self._hook_all_methods(cls, name, _ProfileHook(self, name))

    def _hook_action_bar(self):
        cls = find_class("org.telegram.ui.ActionBar.ActionBar")
        if not cls:
            return
        # User requested hook list
        for name in (
            "setTitle",
            "setSubtitle",
            "setBackButtonImage",
            "createMenu",
            "onButtonClick",
            "setTitleColor",
            "setHeaderShadow",
            "setBackgroundColor",
            "setOccupyStatusBar",
            "setSearchFieldHint",
        ):
            self._hook_all_methods(cls, name, _ActionBarHook(self, name))

    def _hook_launch_activity(self):
        cls = find_class("org.telegram.ui.LaunchActivity")
        if not cls:
            return
        # User requested hook list
        for name in ("handleIntent", "onResume", "switchToAccount", "showPasscode"):
            self._hook_all_methods(cls, name, _LaunchHook(self, name))

    def _hook_actionbar_menu_click(self):
        cls = find_class("org.telegram.ui.ActionBar.ActionBar$ActionBarMenuOnItemClick")
        if not cls:
            return
        self._hook_all_methods(cls, "onItemClick", _ActionBarMenuClickHook(self))

    def _hook_shared_media_layout(self):
        cls = find_class("org.telegram.ui.Components.SharedMediaLayout")
        if not cls:
            return
        try:
            refs = self.hook_all_constructors(cls, _SharedMediaCtorHook(self))
            if refs:
                if isinstance(refs, list):
                    self._hook_refs.extend(refs)
                else:
                    self._hook_refs.append(refs)
        except Exception:
            pass

        for name in ("setUserInfo", "setChatInfo", "updateTabs", "scrollToPage"):
            self._hook_all_methods(cls, name, _SharedMediaHook(self, name))

    def _hook_all_methods(self, cls, method_name, hook):
        try:
            refs = self.hook_all_methods(cls, method_name, hook)
            if not refs:
                return
            if isinstance(refs, list):
                self._hook_refs.extend(refs)
            else:
                self._hook_refs.append(refs)
        except Exception:
            pass

    def _on_profile_event(self, method_name, param, before):
        if before:
            return
        profile = param.thisObject
        if profile is not None:
            self._profile_ref = weakref.ref(profile)
        if method_name in ("onFragmentCreate", "setUserInfo", "createMenu"):
            run_on_ui_thread(self._sync_all_layouts, 60)
        elif method_name in ("updateOnlineStatus", "expandHeader"):
            run_on_ui_thread(self._refresh_search_hint_on_action_bar)
        elif method_name == "onAvatarClick":
            run_on_ui_thread(self._focus_current_search)

    def _on_action_bar_event(self, method_name, param, before):
        action_bar = param.thisObject
        if not self._belongs_to_profile(action_bar):
            return

        if method_name == "setSearchFieldHint" and before:
            if param.args and len(param.args) > 0:
                param.args[0] = self._hint_text()
            return

        if before:
            return

        self._action_bar_ref = weakref.ref(action_bar)

        if method_name in ("createMenu", "setTitle", "setSubtitle", "setBackgroundColor"):
            if method_name == "createMenu":
                run_on_ui_thread(lambda: self._ensure_actionbar_filter_item(action_bar))
            run_on_ui_thread(self._refresh_search_hint_on_action_bar)

    def _on_actionbar_menu_click(self, param):
        try:
            if not param.args:
                return
            item_id = int(param.args[0])
            if item_id != MENU_FILTER_ID:
                return
            fragment = get_last_fragment()
            if fragment is None or "ProfileActivity" not in str(fragment.getClass().getName()):
                return
            run_on_ui_thread(self._show_filter_dialog)
            param.setResult(None)
        except Exception:
            pass

    def _on_launch_event(self, method_name, param, before):
        if method_name in ("handleIntent", "switchToAccount", "showPasscode") and before:
            return
        if method_name == "onResume" and not before:
            if bool(self.get_setting("keep_after_resume", True)):
                run_on_ui_thread(self._sync_all_layouts, 120)

    def _on_shared_media_event(self, method_name, param):
        layout = param.thisObject
        self._attach_shared_media_layout(layout)
        if method_name in ("setUserInfo", "setChatInfo", "updateTabs", "scrollToPage"):
            run_on_ui_thread(lambda: self._apply_query_to_layout(layout), 30)

    def _attach_shared_media_layout(self, layout):
        if layout is None:
            return
        lid = id(layout)
        if lid not in self._layout_refs:
            self._layout_refs[lid] = weakref.ref(layout)
        run_on_ui_thread(lambda: self._ensure_inline_search_bar(layout))
        run_on_ui_thread(lambda: self._apply_query_to_layout(layout), 80)

    def _ensure_inline_search_bar(self, layout):
        try:
            if not isinstance(layout, ViewGroup):
                return
        except Exception:
            return

        lid = id(layout)
        existing_state = self._bar_state.get(lid)
        if existing_state and existing_state.get("bar") is not None:
            bar = existing_state.get("bar")
            if _safe_call(lambda: bar.getParent()) is not None:
                self._apply_hint_to_edit(existing_state.get("edit"))
                return

        ctx = _safe_call(layout.getContext)
        if ctx is None:
            return

        container = LinearLayout(ctx)
        container.setTag(SEARCH_BAR_TAG)
        container.setOrientation(LinearLayout.HORIZONTAL)
        container.setGravity(Gravity.CENTER_VERTICAL)
        container.setPadding(AndroidUtilities.dp(12), AndroidUtilities.dp(8), AndroidUtilities.dp(12), AndroidUtilities.dp(6))

        bg = GradientDrawable()
        bg.setCornerRadius(float(AndroidUtilities.dp(16)))
        bg.setColor(self._theme_color("key_profile_tabBackground", 0x223A4B60))
        container.setBackground(bg)

        edit = EditText(ctx)
        edit.setSingleLine(True)
        edit.setInputType(InputType.TYPE_CLASS_TEXT)
        edit.setBackground(None)
        edit.setPadding(AndroidUtilities.dp(12), AndroidUtilities.dp(6), AndroidUtilities.dp(12), AndroidUtilities.dp(6))
        edit.setTextColor(self._theme_color("key_windowBackgroundWhiteBlackText", 0xFFFFFFFF))
        edit.setHintTextColor(self._theme_color("key_windowBackgroundWhiteGrayText2", 0xFF90A4AE))
        self._apply_hint_to_edit(edit)
        _safe_call(lambda: edit.setText(self._query))
        _safe_call(lambda: edit.setSelection(len(self._query)))

        clear_btn = ImageView(ctx)
        clear_btn.setImageResource(self._resolve_drawable_id(ctx, "msg_close", "ic_ab_back"))
        clear_btn.setColorFilter(self._theme_color("key_profile_actionIcon", 0xFFFFFFFF))
        clear_btn.setOnClickListener(OnClickListener(lambda v: edit.setText("")))

        watcher = self._new_text_watcher(layout)
        if watcher is not None:
            _safe_call(lambda: edit.addTextChangedListener(watcher))

        lp_edit = LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT)
        lp_edit.weight = 1.0
        lp_btn = LinearLayout.LayoutParams(AndroidUtilities.dp(36), AndroidUtilities.dp(36))
        container.addView(edit, lp_edit)
        container.addView(clear_btn, lp_btn)

        root_lp = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT)
        try:
            layout.addView(container, 0, root_lp)
        except Exception:
            try:
                layout.addView(container, root_lp)
            except Exception:
                return

        self._bar_state[lid] = {"bar": container, "edit": edit, "watcher": watcher}

    def _new_text_watcher(self, layout):
        plugin = self

        class _Watcher(dynamic_proxy(TextWatcher)):
            def beforeTextChanged(self, s, st, c, a):
                pass

            def onTextChanged(self, s, st, b, c):
                pass

            def afterTextChanged(self, s):
                if plugin._suppress_text_events:
                    return
                value = str(s.toString() if s is not None else "").strip()
                plugin._set_query(value, from_ui=True)
                plugin._apply_query_to_layout(layout)

        try:
            return _Watcher()
        except Exception:
            return None

    def _set_query(self, value, from_ui=False):
        normalized = str(value or "").strip()
        if normalized == self._query and from_ui:
            return
        self._query = normalized
        _safe_call(lambda: self.set_setting("media_user_query", normalized))

        if not from_ui:
            self._update_bar_edit_texts(normalized)

        run_on_ui_thread(self._sync_all_layouts)

    def _update_bar_edit_texts(self, value):
        self._suppress_text_events = True
        try:
            for state in list(self._bar_state.values()):
                edit = state.get("edit")
                if edit is None:
                    continue
                _safe_call(lambda: edit.setText(value))
                _safe_call(lambda: edit.setSelection(len(value)))
        finally:
            self._suppress_text_events = False

    def _sync_all_layouts(self):
        dead = []
        for lid, ref in list(self._layout_refs.items()):
            layout = _safe_call(ref)
            if layout is None:
                dead.append(lid)
                continue
            self._ensure_inline_search_bar(layout)
            self._apply_query_to_layout(layout)

        for lid in dead:
            self._layout_refs.pop(lid, None)
            self._bar_state.pop(lid, None)

    def _apply_query_to_layout(self, layout):
        item = self._get_layout_search_item(layout)
        if item is None:
            return

        _safe_call(lambda: item.setSearchFieldHint(self._hint_text()))

        query = self._native_query(self._query)
        if query:
            _safe_call(lambda: item.openSearch(False))
            _safe_call(lambda: item.setSearchFieldText(query, False))
        else:
            _safe_call(lambda: item.setSearchFieldText("", False))

    def _get_layout_search_item(self, layout):
        if layout is None:
            return None
        item = _safe_call(lambda: layout.getSearchItem())
        if item is not None:
            return item
        return _safe_call(lambda: get_private_field(layout, "searchItem"))

    def _native_query(self, value):
        q = str(value or "").strip()
        if not q:
            return ""
        if q.lower().startswith("from:"):
            return q
        if q.startswith("@"):
            return "from:" + q[1:]
        return "from:" + q

    def _show_filter_dialog(self):
        fragment = get_last_fragment()
        if fragment is None:
            return
        activity = _safe_call(fragment.getParentActivity)
        if activity is None:
            return

        edit = EditText(activity)
        edit.setInputType(InputType.TYPE_CLASS_TEXT)
        edit.setSingleLine(True)
        edit.setHint(self._hint_text())
        _safe_call(lambda: edit.setText(self._query))
        _safe_call(lambda: edit.setSelection(len(self._query)))

        builder = AlertDialogBuilder(activity)
        builder.setTitle("Media filter by user")
        builder.setView(edit)
        builder.setPositiveButton("Apply", lambda d, w: self._on_dialog_apply(edit))
        builder.setNegativeButton("Clear", lambda d, w: self._set_query(""))
        builder.setNeutralButton("Cancel", None)
        builder.show()

    def _on_dialog_apply(self, edit):
        value = _safe_call(lambda: str(edit.getText()).strip(), "")
        self._set_query(value)
        self._show_bulletin("Media filter: %s" % (value or "off"))

    def _ensure_actionbar_filter_item(self, action_bar):
        if action_bar is None:
            return
        menu = _safe_call(action_bar.createMenu)
        if menu is None:
            menu = _safe_call(lambda: get_private_field(action_bar, "menu"))
        if menu is None:
            return

        existing = _safe_call(lambda: menu.getItem(MENU_FILTER_ID))
        if existing is not None:
            return

        icon = self._resolve_drawable_id(action_bar.getContext(), "msg_search", "menu_search")
        _safe_call(lambda: menu.addItem(jint(MENU_FILTER_ID), jint(icon)))

    def _refresh_search_hint_on_action_bar(self):
        action_bar = self._action_bar()
        if action_bar is None:
            return
        _safe_call(lambda: action_bar.setSearchFieldHint(self._hint_text()))

    def _focus_current_search(self):
        for state in list(self._bar_state.values()):
            edit = state.get("edit")
            if edit is None:
                continue
            _safe_call(edit.requestFocus)
            return

    def _apply_hint_to_edit(self, edit):
        if edit is None:
            return
        _safe_call(lambda: edit.setHint(self._hint_text()))

    def _hint_text(self):
        return str(self.get_setting("search_hint", "Filter media by @username / user id"))

    def _profile(self):
        return _safe_call(self._profile_ref) if self._profile_ref else None

    def _action_bar(self):
        return _safe_call(self._action_bar_ref) if self._action_bar_ref else None

    def _belongs_to_profile(self, action_bar):
        if action_bar is None:
            return False
        parent = _safe_call(lambda: get_private_field(action_bar, "parentFragment"))
        if parent is None:
            parent = _safe_call(lambda: get_private_field(action_bar, "fragment"))
        if parent is None:
            return False
        return "ProfileActivity" in str(_safe_call(lambda: parent.getClass().getName(), str(parent)))

    def _theme_color(self, key_name, fallback):
        try:
            if hasattr(Theme, key_name):
                return int(Theme.getColor(getattr(Theme, key_name)))
        except Exception:
            pass
        try:
            return int(Theme.getColor(key_name))
        except Exception:
            return int(fallback)

    def _resolve_drawable_id(self, context, *names):
        try:
            res = context.getResources()
            pkg = context.getPackageName()
            for name in names:
                rid = int(res.getIdentifier(name, "drawable", pkg))
                if rid != 0:
                    return rid
        except Exception:
            pass
        return 0

    def _show_bulletin(self, text):
        _safe_call(lambda: BulletinHelper.show_info(str(text)))

    def _dlog(self, message):
        if not self._debug:
            return
        _safe_call(lambda: log("%s %s" % (TAG, str(message))))
